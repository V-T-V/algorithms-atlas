{
  "name": "algorithms-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "算法图谱 —— 3000 个计算机算法的 TS 实现 + 中英双语描述 + 交互式动画演示。可双击打开的纯前端静态站。",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,css,md}\"",
    "test": "node --test --import tsx \"test/**/*.test.ts\"",
    "test:run": "node --test --import tsx \"test/**/*.test.ts\"",
    "product:check": "node scripts/product-check.mjs",
    "product:curriculum": "node scripts/export-curriculum.mjs",
    "new": "node scripts/new-algorithm.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0"
  }
}
